.footer-links a { font-family: var(--font-mono); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #999; text-decoration: none; transition: color .2s; }
.footer-links a:hover { color: var(--accent); }

/* ── KEYFRAMES ── */
@keyframes slideDown { from{transform:translateY(-100%);opacity:0} to{transform:translateY(0);opacity:1} }
@keyframes fadeUp { from{transform:translateY(20px);opacity:0} to{transform:translateY(0);opacity:1} }
@keyframes clipUp { from{clip-path:inset(0 0 100% 0);transform:translateY(10px)} to{clip-path:inset(0 0 0% 0);transform:translateY(0)} }
