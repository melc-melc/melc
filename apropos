:root {
  color-scheme: light;
  --bg:        #f5f4f2;
  --surface:   #eeedea;
  --surface2:  #e8e6e2;
  --border:    rgba(0,0,0,0.08);
  --border-hi: rgba(0,230,57,0.5);
  --accent:    #00E639;
  --text:      #0e0e0e;
  --text-dim:  #555555;
  --muted:     #999999;
  --font-head: 'Bebas Neue', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  --font-mono: 'Space Mono', monospace;
}

html { scroll-behavior: smooth; background: #f5f4f2 !important; }
body {
  background: #f5f4f2 !important; color: #0e0e0e !important;
  font-family: var(--font-body); font-weight: 300;
  overflow-x: hidden; cursor: none;
  -webkit-font-smoothing: antialiased;
}

/* ── CURSOR ── */
#cur {
  position: fixed; z-index: 9999; width: 9px; height: 9px;
  background: var(--accent); border-radius: 50%;
  pointer-events: none; transform: translate(-50%,-50%);
  transition: width .2s, height .2s;
}
#cur-ring {
  position: fixed; z-index: 9998; width: 36px; height: 36px;
  border: 1px solid rgba(0,230,57,.5); border-radius: 50%;
  pointer-events: none; transform: translate(-50%,-50%);
  transition: width .35s cubic-bezier(.23,1,.32,1), height .35s cubic-bezier(.23,1,.32,1), border-color .25s;
}
body.hov #cur { width: 4px; height: 4px; }
body.hov #cur-ring { width: 52px; height: 52px; border-color: var(--accent); }
@media(max-width:768px){ #cur, #cur-ring { display: none; } body { cursor: auto; } }

/* ── NOISE ── */
body::before {
  content: ''; position: fixed; inset: 0; z-index: 1;
  background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  opacity: .035; pointer-events: none;
}

/* ── GRID ── */
body::after {
  content: ''; position: fixed; inset: 0; z-index: 0;
  background-image:
    linear-gradient(rgba(0,0,0,0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,0.06) 1px, transparent 1px);
  background-size: 72px 72px; pointer-events: none;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 40%, black 10%, transparent 100%);
}

/* ── NAV ── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 48px; height: 64px;
  border-bottom: 1px solid rgba(0,0,0,0.08);
  background: rgba(245,244,242,.92);
  backdrop-filter: blur(28px); -webkit-backdrop-filter: blur(28px);
  animation: slideDown .7s .1s both;
}
@media(max-width:600px){ nav { padding: 0 20px; height: 56px; } }
.nav-logo { font-family: var(--font-head); font-size: 20px; letter-spacing: 5px; color: #0e0e0e; text-decoration: none; flex-shrink: 0; }
.nav-logo span { color: var(--accent); }
.nav-links { display: flex; align-items: center; gap: 36px; list-style: none; }
@media(max-width:700px){ .nav-links { gap: 18px; } }
@media(max-width:480px){ .nav-links { gap: 12px; } }
.nav-links a {
  font-family: var(--font-mono); font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  color: #999; text-decoration: none; transition: color .2s; position: relative; white-space: nowrap;
}
.nav-links a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 1px; background: var(--accent); transition: width .3s; }
.nav-links a:hover { color: #0e0e0e; }
.nav-links a:hover::after { width: 100%; }
.nav-links a.active { color: #0e0e0e; }
.nav-links a.active::after { width: 100%; }
.nav-cta {
  display: inline-flex; align-items: center; padding: 8px 18px;
  background: #0e0e0e; color: #f5f4f2 !important;
  font-family: var(--font-mono); font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  text-decoration: none; font-weight: 700; transition: background .2s !important;
}
.nav-cta::after { display: none !important; }
.nav-cta:hover { background: var(--accent); color: #0e0e0e !important; }

/* ── HERO ── */
.hero {
  position: relative; z-index: 2;
  padding: 160px 48px 100px; overflow: hidden;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
@media(max-width:600px){ .hero { padding: 120px 20px 72px; } }

.orb {
  position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none;
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(0,230,57,.15) 0%, transparent 68%);
  top: -20%; right: -10%;
  animation: drift 15s ease-in-out infinite alternate;
}
@keyframes drift { from{transform:translate(0,0)} to{transform:translate(20px,35px)} }

.hero-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end;
}
@media(max-width:800px){ .hero-inner { grid-template-columns: 1fr; gap: 40px; } }

.hero-eyebrow {
  display: flex; align-items: center; gap: 14px; margin-bottom: 28px;
  animation: fadeUp .7s .3s both;
}
.eyebrow-line { width: 28px; height: 1px; background: var(--accent); }
.eyebrow-text { font-family: var(--font-mono); font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: #999; }

.hero-headline {
  font-family: var(--font-head);
  font-size: clamp(60px,9vw,120px);
  line-height: .88; letter-spacing: -1px; color: #0e0e0e;
  animation: clipUp .9s .4s both;
}
.hero-headline em { font-style: normal; color: var(--accent); }

.hero-right { animation: fadeUp .7s .7s both; }
.hero-intro {
  font-size: clamp(16px,2vw,20px); line-height: 1.8; color: #0e0e0e; font-weight: 300;
  border-left: 2px solid var(--accent); padding-left: 24px;
}
.hero-intro strong { color: #0e0e0e; font-weight: 500; }

/* ── STORY ── */
.story {
  position: relative; z-index: 2;
  display: grid; grid-template-columns: 1fr 2fr; gap: 0;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
@media(max-width:800px){ .story { grid-template-columns: 1fr; } }

.story-nav {
  padding: 60px 48px; border-right: 1px solid rgba(0,0,0,0.08);
  position: sticky; top: 64px; height: fit-content;
  background: var(--surface);
}
@media(max-width:800px){ .story-nav { display: none; } }

.story-nav-title { font-family: var(--font-mono); font-size: 8px; letter-spacing: 3px; text-transform: uppercase; color: #999; margin-bottom: 24px; }
.story-nav-links { display: flex; flex-direction: column; gap: 0; }
.story-nav-link {
  display: flex; align-items: center; gap: 12px; padding: 12px 0;
  border-bottom: 1px solid rgba(0,0,0,0.06);
  font-family: var(--font-mono); font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
  color: #999; text-decoration: none; transition: color .2s;
}
.story-nav-link:hover { color: #0e0e0e; }
.story-nav-link.active { color: #0e0e0e; }
.nav-dot { width: 4px; height: 4px; border-radius: 50%; background: #ccc; flex-shrink: 0; transition: background .2s; }
.story-nav-link.active .nav-dot { background: var(--accent); }

.story-content { padding: 60px 48px; display: flex; flex-direction: column; gap: 0; }
@media(max-width:600px){ .story-content { padding: 40px 20px; } }

.story-block { padding: 48px 0; border-bottom: 1px solid rgba(0,0,0,0.08); }
.story-block:first-child { padding-top: 0; }
.story-block:last-child { border-bottom: none; padding-bottom: 0; }

.block-num { font-family: var(--font-mono); font-size: 9px; letter-spacing: 3px; color: var(--accent); margin-bottom: 16px; }
.block-title { font-family: var(--font-head); font-size: clamp(28px,4vw,48px); letter-spacing: 1px; margin-bottom: 20px; line-height: 1; color: #0e0e0e; }
.block-text { font-size: 15px; line-height: 1.9; color: #555; max-width: 560px; }
.block-text strong { color: #0e0e0e; font-weight: 400; }
.block-text + .block-text { margin-top: 16px; }

.block-quote {
  margin: 28px 0; padding: 24px 28px;
  border-left: 2px solid var(--accent);
  background: rgba(0,230,57,.05);
}
.block-quote p { font-family: var(--font-head); font-size: clamp(20px,3vw,32px); line-height: 1.1; letter-spacing: .5px; color: #0e0e0e; }

/* ── COMMENT ÇA MARCHE ── */
.how {
  position: relative; z-index: 2;
  padding: 100px 48px; border-bottom: 1px solid rgba(0,0,0,0.08);
}
@media(max-width:600px){ .how { padding: 72px 20px; } }

.how-header { display: flex; align-items: baseline; gap: 20px; margin-bottom: 64px; }
.how-num { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; color: var(--accent); }
.how-title { font-family: var(--font-head); font-size: clamp(32px,5vw,60px); letter-spacing: 1px; color: #0e0e0e; }

.steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 2px; }
@media(max-width:900px){ .steps { grid-template-columns: repeat(2,1fr); } }
@media(max-width:480px){ .steps { grid-template-columns: 1fr; } }

.step {
  background: var(--surface); border: 1px solid rgba(0,0,0,0.08);
  padding: 36px 28px; position: relative; overflow: hidden; transition: border-color .3s;
}
.step:hover { border-color: rgba(0,230,57,.5); }
.step::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(to right, var(--accent), transparent);
  transform: scaleX(0); transform-origin: left;
  transition: transform .5s cubic-bezier(.16,1,.3,1);
}
.step:hover::before { transform: scaleX(1); }
.step-num { font-family: var(--font-head); font-size: 48px; line-height: 1; color: rgba(0,230,57,.15); margin-bottom: 16px; transition: color .3s; }
.step:hover .step-num { color: rgba(0,230,57,.3); }
.step-icon { font-size: 24px; margin-bottom: 16px; display: block; }
.step-title { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #0e0e0e; margin-bottom: 12px; }
.step-desc { font-size: 13px; line-height: 1.7; color: #555; }

/* ── FAQ ── */
.faq { position: relative; z-index: 2; padding: 100px 48px; border-bottom: 1px solid rgba(0,0,0,0.08); }
@media(max-width:600px){ .faq { padding: 72px 20px; } }

.faq-header { display: flex; align-items: baseline; gap: 20px; margin-bottom: 64px; }
.faq-num { font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; color: var(--accent); }
.faq-title { font-family: var(--font-head); font-size: clamp(32px,5vw,60px); letter-spacing: 1px; color: #0e0e0e; }

.faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
@media(max-width:700px){ .faq-grid { grid-template-columns: 1fr; } }

.faq-item {
  background: var(--surface); border: 1px solid rgba(0,0,0,0.08);
  padding: 32px 28px; cursor: none; transition: border-color .3s, box-shadow .3s;
  position: relative; overflow: hidden;
}
.faq-item:hover { border-color: rgba(0,230,57,.5); box-shadow: 0 4px 24px rgba(0,230,57,.06); }
.faq-item::before {
  content: ''; position: absolute; top: 0; left: 0; bottom: 0; width: 2px;
  background: var(--accent); transform: scaleY(0); transform-origin: top;
  transition: transform .4s cubic-bezier(.16,1,.3,1);
}
.faq-item:hover::before { transform: scaleY(1); }

.faq-q { font-family: var(--font-head); font-size: clamp(18px,2.5vw,26px); letter-spacing: .5px; color: #0e0e0e; margin-bottom: 14px; line-height: 1.1; }
.faq-a { font-size: 13px; line-height: 1.75; color: #555; }
.faq-a strong { color: #0e0e0e; font-weight: 400; }

/* ── CTA ── */
.cta-section {
  position: relative; z-index: 2;
  padding: 100px 48px; text-align: center; overflow: hidden;
  background: var(--surface);
}
@media(max-width:600px){ .cta-section { padding: 72px 20px; } }

.cta-orb {
  position: absolute; border-radius: 50%; filter: blur(120px); pointer-events: none;
  width: 600px; height: 300px;
  background: radial-gradient(ellipse, rgba(0,230,57,.12) 0%, transparent 70%);
  top: 50%; left: 50%; transform: translate(-50%,-50%);
  animation: breathe 5s ease-in-out infinite alternate;
}
@keyframes breathe { from{opacity:.5;transform:translate(-50%,-50%) scale(.9)} to{opacity:1;transform:translate(-50%,-50%) scale(1.1)} }

.cta-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 4px; text-transform: uppercase; color: #999; margin-bottom: 24px; position: relative; }
.cta-headline { font-family: var(--font-head); font-size: clamp(48px,9vw,110px); line-height: .9; letter-spacing: -1px; position: relative; margin-bottom: 48px; color: #0e0e0e; }
.cta-headline span { color: var(--accent); }

.btn-primary {
  position: relative; overflow: hidden;
  display: inline-flex; align-items: center; gap: 12px;
  padding: 16px 40px; background: #0e0e0e; color: #f5f4f2;
  font-family: var(--font-mono); font-size: 10px;
  letter-spacing: 2px; text-transform: uppercase;
  text-decoration: none; font-weight: 700;
  clip-path: polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));
  transition: color .3s;
}
.btn-primary::before { content: ''; position: absolute; inset: 0; background: var(--accent); transform: translateX(-102%); transition: transform .42s cubic-bezier(.16,1,.3,1); }
.btn-primary:hover::before { transform: translateX(0); }
.btn-primary:hover { color: #0e0e0e; }
.btn-primary > * { position: relative; z-index: 1; }
.btn-arr { transition: transform .3s; }
.btn-primary:hover .btn-arr { transform: translateX(5px); }

/* ── FOOTER ── */
footer {
  position: relative; z-index: 2;
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;
  padding: 24px 48px; border-top: 1px solid rgba(0,0,0,0.08); background: var(--surface2);
}
@media(max-width:600px){ footer { padding: 20px; flex-direction: column; align-items: flex-start; } }
.footer-logo { font-family: var(--font-head); font-size: 16px; letter-spacing: 4px; color: #999; }
.footer-logo span { color: var(--accent); }
.footer-copy { font-family: var(--font-mono); font-size: 9px; letter-spacing: 2px; color: #999; }
.footer-links { display: flex; gap: 24px; }
.footer-links a { font-family: var(--font-mono); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #999; text-decoration: none; transition: color .2s; }
.footer-links a:hover { color: var(--accent); }

/* ── KEYFRAMES ── */
@keyframes slideDown { from{transform:translateY(-100%);opacity:0} to{transform:translateY(0);opacity:1} }
@keyframes fadeUp { from{transform:translateY(24px);opacity:0} to{transform:translateY(0);opacity:1} }
@keyframes clipUp { from{clip-path:inset(0 0 100% 0);transform:translateY(10px)} to{clip-path:inset(0 0 0% 0);transform:translateY(0)} }

.reveal { opacity:0; transform:translateY(30px); transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1); }
.reveal.visible { opacity:1; transform:translateY(0); }
.rd1{transition-delay:.1s} .rd2{transition-delay:.2s} .rd3{transition-delay:.3s} .rd4{transition-delay:.4s}
```

