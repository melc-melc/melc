<script>
  const cur  = document.getElementById('cur');
  const ring = document.getElementById('cur-ring');
  let mx=0,my=0,rx=0,ry=0;
  document.addEventListener('mousemove',e=>{
    mx=e.clientX; my=e.clientY;
    cur.style.left=mx+'px'; cur.style.top=my+'px';
  });
  (function loop(){
    rx+=(mx-rx)*.12; ry+=(my-ry)*.12;
    ring.style.left=rx+'px'; ring.style.top=ry+'px';
    requestAnimationFrame(loop);
  })();
  document.querySelectorAll('a,button,.faq-item,.step').forEach(el=>{
    el.addEventListener('mouseenter',()=>document.body.classList.add('hov'));
    el.addEventListener('mouseleave',()=>document.body.classList.remove('hov'));
  });

  const io = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('visible'); });
  },{threshold:.08});
  document.querySelectorAll('.reveal').forEach(r=>io.observe(r));

  const sections = document.querySelectorAll('[id]');
  const navLinks = document.querySelectorAll('.story-nav-link');
  window.addEventListener('scroll',()=>{
    let current = '';
    sections.forEach(s=>{ if(window.scrollY >= s.offsetTop - 120) current = s.id; });
    navLinks.forEach(l=>{
      l.classList.remove('active');
      l.querySelector('.nav-dot').style.background = '#ccc';
      if(l.getAttribute('href') === '#'+current){
        l.classList.add('active');
        l.querySelector('.nav-dot').style.background = '#00E639';
      }
    });
  });

  document.addEventListener('mousemove',e=>{
    const x=(e.clientX/window.innerWidth-.5)*24;
    const y=(e.clientY/window.innerHeight-.5)*24;
    document.querySelector('.orb').style.transform=`translate(${x}px,${y}px)`;
  });
</script>

